/*from pg 652, chp 13, vol2 of tsang */
#define maxgen 4

#define d1 120.00	    /* average divergence angle 1 */
#define a 22.5	    /* average branching angle */
#define lr 1.2	    /* avg length increase rate  */
#define vr 1.2	    /* bavg width increase rate */
#define le 12    /* avg intiial length */
#define width 100    

START : !(vr*(0.9+0.1*rand(2)))F(20*(0.9+0.1*rand(2)))/(180+rand(180))A 

p1 : A -> !(vr*(0.9+0.1*(rand(2))))[& (15+rand(15)) F(le*(0.9+0.1*rand(2))) A]/(100+rand(40))[&(15+rand(15)) F(le*(0.9+0.1*rand(2))) A]/(100+rand(40))[&(15+rand(15)) F(le*(0.9+0.1*rand(2))) A]
p2 : F(l) -> F(l*lr*(0.9+0.1*rand(2))) 
p3 : !(w) -> !(w*vr*(0.9+0.1*rand(2))) 
